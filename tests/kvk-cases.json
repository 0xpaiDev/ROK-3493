               "weights": { "t4Kill": 1, "t5Kill": 2, "t4Death": 4, "t5Death": 8 },
               "periods": [{ "startsOn": "2020-01-10", "endsOn": "2020-01-14" }, { "startsOn": "2020-01-20", "endsOn": null }] },
      "refused": null
    },
